# MongoDB Atlas connection string for the read-only chatbot service account.
# Get this from whoever manages the Atlas cluster. Never put the real value here.
MONGODB_URI=

# Which database inside that cluster to read. "marketplace" is the real one.
#
# SET THIS TO "marketplace_demo" FOR ANYTHING THAT REACHES AN LLM - demos, the
# live test, manual /chat poking. Staging holds real customer data
# (delivery cities, courier tracking numbers), and the free LLM tiers
# state that submitted content may be used to improve their products and
# may be seen by human reviewers.
#
# Repo-level tests can stay on "marketplace": they read real data but never
# transmit it anywhere. Seed the demo database with:
#     uv run python scripts/seed_demo_data.py
MONGODB_DATABASE=marketplace

# OPTIONAL - API key for Groq. https://console.groq.com/keys
#
# LEAVE BLANK to run on Azure alone, which is the intended setup while
# the Azure credit is live. Groq's free tier reserves the right to train
# on what it is sent, so it is dropped automatically whenever
# MONGODB_DATABASE holds real customers - but blanking it here removes
# the possibility entirely, including for demo data.
#
# Putting a key back restores the fallback with no code change.
LLM_API_KEY=

# Secret used to verify the JWT tokens sent by the marketplace mobile app.
# Ask the main the marketplace backend team for this — it must match theirs exactly.
# Under RS256/ES256 this holds their PUBLIC key (PEM), not a shared secret.
JWT_SECRET=

# OPTIONAL — how the marketplace backend signs and shapes its tokens. Defaults
# are our best guess and work for local testing; the moment the backend
# team confirms the real values, set them HERE rather than in code.
#
# JWT_ALGORITHM: HS256 (shared secret) or RS256/ES256 (public key above).
#   "none" is refused - it means unsigned, i.e. anyone can forge a token.
# JWT_USER_ID_CLAIMS: comma-separated claim names to look for the user ID
#   in, in priority order; the first one PRESENT in the token wins. Once
#   the real name is known, narrow this to that single value.
#   The app logs which claim matched ("jwt_user_id_claim_matched"), so a
#   real sample token tells you the answer.
# JWT_AUDIENCE / JWT_ISSUER: when set, tokens for a different audience or
#   from a different issuer are rejected. Leave blank to skip the check.
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIMS=user_id,userId,sub,_id
JWT_AUDIENCE=
JWT_ISSUER=

# OPTIONAL — API key for the FALLBACK LLM provider (Google AI Studio).
# Free tier, no card: https://aistudio.google.com/apikey
# Leave blank to run on Groq alone; the app starts either way. Exists
# because Groq's free tier caps at 8,000 tokens/minute, which one
# multi-round conversation can exhaust on its own.
GEMINI_API_KEY=
# OPTIONAL — per-user rate limit on /chat, keyed on the verified JWT
# subject. Defaults are generous for a person (a human conversation is a
# handful of messages a minute) while stopping a retry loop or a leaked
# token from issuing thousands. Set CHAT_RATE_LIMIT_REQUESTS=0 to turn
# the limiter off entirely.
#
# NOTE this bounds ONE user, not total load - many users within their
# allowance can still exhaust the shared LLM quota between them, which
# the assistant already survives by answering "I'm handling a lot of
# requests right now" rather than failing.
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# OPTIONAL - where the app's SHARED state lives between requests.
#
# Two things depend on it, and both break in the same way without it:
#
#   conversation memory   UNSET = an in-process dict, wiped by every
#                         restart or deploy, so a user mid-conversation
#                         suddenly gets "which product?" out of nowhere.
#                         With several workers a follow-up can land on a
#                         worker that never saw the first message, which
#                         reads as the AI being flaky rather than as an
#                         infrastructure problem.
#
#   the /chat rate limit  UNSET = counted per worker, so the real
#                         allowance is (workers x CHAT_RATE_LIMIT_
#                         REQUESTS) and the number below means nothing.
#                         Nothing warns you: it is exactly right on one
#                         worker and wrong on four.
#
# SET IT before deploying anywhere with more than one process. A free
# Upstash Redis (https://upstash.com) covers a POC comfortably. Use the
# Redis-protocol URL (rediss://...:6379), NOT the Upstash REST URL.
# Neither conversation history nor rate-limit counts touch MongoDB.
REDIS_URL=

# OPTIONAL - a shared code the /demo surface demands before it shows
# anything. UNSET = no gate, which is right for a laptop.
#
# SET IT FOR ANY REACHABLE URL. /demo/accounts lists real buyers and
# /demo/token signs in as any of them with no password - safe on your own
# machine, a customer directory behind a link. With a code set, an
# unauthorised visitor sees a code box and nothing else: no names, no
# counts, no catalogue.
#
# One shared secret, not a password and not per-user. It turns "anyone
# who finds the URL" into "anyone you told" - and a leaked code is a
# leaked door, so treat it like one.
DEMO_ACCESS_CODE=

# OPTIONAL - serve the demo chat page at /demo. Defaults to true.
#
# Leave it alone for demos and local development. Set it to false for
# any PUBLIC deployment: the page cannot answer without a valid the marketplace
# token, so it is an unnecessary door rather than a leak, but it
# advertises the service to anyone who finds the URL and invites people
# to paste a bearer token into a web page.
#
# The app logs demo_ui_enabled or demo_ui_disabled at every startup, so
# which state you are in is never a guess.
DEMO_UI_ENABLED=true

# OPTIONAL - a SECOND provider whose terms exclude training on prompts.
#
# THIS IS THE ONLY THING THAT STOPS AZURE BEING A SINGLE POINT OF FAILURE.
# While MONGODB_DATABASE holds real customers, Groq and Gemini are dropped
# from the chain automatically, so Azure is alone - and its credit has an
# expiry date (below). On that day every request returns "I can't reach my
# assistant service" until something changes.
#
# Any OpenAI-compatible chat-completions endpoint works: OpenAI's own API,
# a second Azure resource in another subscription or region, AWS Bedrock,
# Google Vertex. For an Azure-shaped one also set BACKUP_LLM_KIND=azure and
# BACKUP_LLM_API_VERSION, and put the DEPLOYMENT name in BACKUP_LLM_MODEL.
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=
BACKUP_LLM_KIND=openai
BACKUP_LLM_API_VERSION=

# Set this to false ONLY if the provider's terms actually say submitted
# content is not used for training. It is a claim about someone else's
# contract and we cannot verify it, so it defaults to TRUE - meaning the
# backup is treated exactly like Groq and dropped the moment real customer
# data is configured. Left alone it will not help on expiry day; set
# wrongly it sends real orders somewhere that may learn from them.
BACKUP_LLM_TRAINS_ON_PROMPTS=true

# OPTIONAL - the date the Azure credit runs out, ISO format.
#
# Recorded because the consequence is sharp: while MONGODB_DATABASE holds
# real customers, Groq and Gemini are dropped from the provider chain, so
# there is NO fallback. On the day this expires every request returns
# "I can't reach my assistant service" until it is renewed.
#
# scripts/check_azure.py prints the days remaining, so the pre-flight
# check before a demo tells you - rather than a calendar entry nobody
# opens. The SERVICE reads it too: it logs llm_chain_preflight at startup
# and reports the risk through /health, so this is no longer something
# only the person who runs the script can find out.
AZURE_CREDIT_EXPIRES=

# ── Embeddings: which model embeds free-text SEARCH QUERIES ──────────
# 'azure' (default) or 'local'. Only affects search_products_semantically;
# find_similar_products reuses a stored vector and needs no model.
EMBEDDING_BACKEND=azure

# Only when EMBEDDING_BACKEND=local. Set these ONLY from a CONFIRMED run
# of scripts/identify_embedding_model.py — a guessed model does not error,
# it returns ranked nonsense. Requires: uv sync --extra local-embeddings
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LOCAL_EMBEDDING_DIMENSIONS=384

# Tag to assume for UNTAGGED embedding documents (the original pipeline
# wrote none, and a read-only credential cannot add them). This is an
# operator assertion backed by the identification script, not a fact read
# from the database — it is logged on every search for exactly that reason.
# LEGACY_EMBEDDING_ASSUMED=local:sentence-transformers/all-MiniLM-L6-v2:384
